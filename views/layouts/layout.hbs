<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/wireguard-color.svg">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/wireguard-color.svg" alt="WireGuard" width="28" height="28">
        <strong>{{__ 'brand.name'}}</strong>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          {{#if user}}
            <li class="nav-item">
              <a class="nav-link" href="/">{{__ 'nav.dashboard'}}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/interface">{{__ 'nav.interfaces'}}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/peers">{{__ 'nav.peers'}}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logs">{{__ 'nav.logs'}}</a>
            </li>
          {{/if}}
        </ul>

        <ul class="navbar-nav ms-2 align-items-center">
          {{#if user}}
            <li class="nav-item me-2">
              <a href="/auth/sudo-password" class="text-decoration-none">
                {{#if hasSudoPassword}}
                  <span class="badge bg-success">{{__ 'nav.sudo_active'}}</span>
                {{else}}
                  <span class="badge bg-warning text-dark">{{__ 'nav.sudo_inactive'}}</span>
                {{/if}}
              </a>
            </li>
            <li class="nav-item me-2">
              <form method="GET" action="/profile/language" class="d-inline">
                <select name="lang" class="form-select form-select-sm bg-dark text-light border-secondary" style="cursor:pointer" data-auto-submit>
                  <option value="de" {{#if (eq lang 'de')}}selected{{/if}}>DE</option>
                  <option value="en" {{#if (eq lang 'en')}}selected{{/if}}>EN</option>
                  <option value="es" {{#if (eq lang 'es')}}selected{{/if}}>ES</option>
                  <option value="fr" {{#if (eq lang 'fr')}}selected{{/if}}>FR</option>
                  <option value="ga" {{#if (eq lang 'ga')}}selected{{/if}}>GA</option>
                  <option value="it" {{#if (eq lang 'it')}}selected{{/if}}>IT</option>
                  <option value="pt" {{#if (eq lang 'pt')}}selected{{/if}}>PT</option>
                </select>
              </form>
            </li>
            <li class="nav-item">
              <a href="/profile" class="btn btn-sm btn-outline-light d-flex align-items-center gap-2 py-1" title="{{__ 'nav.profile'}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/>
                </svg>
                <span>{{userName}}</span>
              </a>
            </li>
            <li class="nav-item ms-2">
              <a href="/logout" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-2 py-1" title="{{__ 'nav.logout'}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                  <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                </svg>
                <span>{{__ 'nav.logout'}}</span>
              </a>
            </li>
          {{else}}
            <li class="nav-item">
              <a class="nav-link" href="/auth/login">{{__ 'nav.login'}}</a>
            </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <main class="container mt-4 flex-grow-1">
    {{#if user}}
      {{#unless hasSudoPassword}}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <a href="/auth/sudo-password" class="alert-link">{{__ 'alert.sudo_password.link'}}</a>
          {{__ 'alert.sudo_password.description'}}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {{/unless}}
    {{/if}}
    {{#if flash}}
      {{#if flash.success}}
        <div class="toast-container position-fixed end-0 p-3" style="z-index: 9999; top: 60px;">
          <div class="toast show align-items-center text-bg-success border-0" role="alert" data-bs-delay="5000">
            <div class="d-flex">
              <div class="toast-body">{{flash.success}}</div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        </div>
      {{/if}}
      {{#if flash.error}}
        <div class="toast-container position-fixed end-0 p-3" style="z-index: 9999; top: 60px;">
          <div class="toast show align-items-center text-bg-danger border-0" role="alert" data-bs-delay="8000">
            <div class="d-flex">
              <div class="toast-body">{{flash.error}}</div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        </div>
      {{/if}}
    {{/if}}

    {{{body}}}
  </main>

  <footer class="bg-dark text-light py-3 mt-auto">
    <div class="container text-center d-flex flex-column flex-sm-row align-items-center justify-content-center gap-2">
      <span class="small">{{__ 'footer.copyright' year=currentYear}}</span>
      <a href="https://ko-fi.com/razganariel" target="_blank" rel="noopener"
         class="btn btn-sm rounded-pill px-3 py-1 text-white d-inline-flex align-items-center gap-1"
         style="background-color:#FF5E5B; font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
          <path d="M7.06 12.5c-1.06-.88-4.06-3.29-4.06-5.64C3 5.13 4 4.5 5 4.5c1.13 0 2.5.63 2.5 2.06h1C8.5 5.13 9.87 4.5 11 4.5c1 0 2 .63 2 2.36 0 2.35-3 4.76-4.06 5.64a1.4 1.4 0 0 1-1.88 0"/>
        </svg>
        {{__ 'footer.support'}}
      </a>
    </div>
  </footer>

  <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">{{__ 'modal.confirm_title'}}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="confirmModalBody"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{__ 'modal.btn_cancel'}}</button>
          <button type="button" class="btn btn-danger" id="confirmModalBtn">{{__ 'modal.btn_confirm'}}</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
