<div class="d-flex align-items-center gap-3 mb-4 mt-2">
  <div class="avatar rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/></svg>
  </div>
  <div>
    <h1 class="h3 mb-1">{{__ 'profile.title'}}</h1>
    <p class="text-muted small mb-0">{{user.prenom}} {{user.nom}}</p>
  </div>
</div>
<div class="row justify-content-center mt-3 g-3">
  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white d-flex align-items-center gap-2">
        <span class="card-icon bg-primary-subtle text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/></svg>
        </span>
        <h5 class="mb-0">{{__ 'profile.personal_info.title'}}</h5>
      </div>
      <div class="card-body">
        <form method="POST" action="/profile" data-validate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div class="row g-3">
            <div class="col-sm-6">
              <label for="prenom" class="form-label">{{__ 'profile.personal_info.first_name'}}</label>
              <input type="text" class="form-control" id="prenom" name="prenom" value="{{user.prenom}}" required maxlength="100">
            </div>
            <div class="col-sm-6">
              <label for="nom" class="form-label">{{__ 'profile.personal_info.last_name'}}</label>
              <input type="text" class="form-control" id="nom" name="nom" value="{{user.nom}}" required maxlength="100">
            </div>
          </div>
          <div class="mt-3">
            <label for="email" class="form-label">{{__ 'profile.personal_info.email'}}</label>
            <input type="email" class="form-control" id="email" name="email" value="{{user.email}}" required>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-primary w-100">{{__ 'profile.personal_info.btn_save'}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="card-icon bg-warning-subtle text-warning-emphasis">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2Zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/></svg>
          </span>
          <h5 class="mb-0">{{__ 'profile.password.title'}}</h5>
        </div>
        {{#if passwordComplexity}}
          <span class="badge bg-success fs-6">{{__ 'profile.password.complexity_on'}}</span>
        {{else}}
          <span class="badge bg-secondary fs-6">{{__ 'profile.password.complexity_off'}}</span>
        {{/if}}
      </div>
      <div class="card-body">
        <form method="POST" action="/profile" data-validate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="prenom" value="{{user.prenom}}">
          <input type="hidden" name="nom" value="{{user.nom}}">
          <input type="hidden" name="email" value="{{user.email}}">

          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="password_complexity" name="password_complexity" value="1" {{#if passwordComplexity}}checked{{/if}}>
            <label class="form-check-label" for="password_complexity">{{__ 'profile.password.complexity_label'}}</label>
          </div>

          <div class="mb-3">
            <label for="current_password" class="form-label">{{__ 'profile.password.current_label'}}</label>
            <div class="input-group">
              <input type="password" class="form-control" id="current_password" name="current_password" autocomplete="current-password" placeholder="{{__ 'profile.password.current_placeholder'}}">
              <button type="button" class="btn btn-outline-secondary" data-toggle-password="current_password" aria-label="{{__ 'profile.password.show'}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
              </button>
            </div>
          </div>

          <div class="mb-3">
            <label for="new_password" class="form-label">{{__ 'profile.password.new_label'}}</label>
            <div class="input-group">
              <input type="password" class="form-control" id="new_password" name="new_password" minlength="8" data-max-bytes="72" autocomplete="new-password" placeholder="{{__ 'profile.password.new_placeholder'}}">
              <button type="button" class="btn btn-outline-secondary" data-toggle-password="new_password" aria-label="{{__ 'profile.password.show'}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
              </button>
            </div>
            <div class="invalid-feedback">{{__ 'error.password_max_bytes'}}</div>
            <div class="form-text">{{__ 'profile.password.max_bytes_help'}}</div>
            <div id="entropy-meter" class="mt-2 d-none">
              <div class="progress" style="height: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" id="entropy-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%"></div>
              </div>
              <small class="mt-1 d-flex justify-content-between gap-2 text-muted">
                <span class="text-truncate">
                  <span id="entropy-label" class="fw-semibold" data-strong="{{__ 'strength.strong'}}" data-medium="{{__ 'strength.medium'}}" data-weak="{{__ 'strength.weak'}}" data-hint-strong="{{__ 'strength.hint_strong'}}" data-hint-medium="{{__ 'strength.hint_medium'}}" data-hint-weak="{{__ 'strength.hint_weak'}}" data-capped="{{__ 'profile.password.max_bytes_reached'}}">—</span>
                  <span id="entropy-feedback" class="ms-1"></span>
                </span>
                <span class="flex-shrink-0">(<span id="entropy-value">0</span> bits<span id="entropy-capped" class="text-warning-emphasis fw-semibold"></span>)</span>
              </small>
            </div>
          </div>

          <div class="mb-3">
            <label for="new_password_confirm" class="form-label">{{__ 'profile.password.confirm_label'}}</label>
            <div class="input-group">
              <input type="password" class="form-control" id="new_password_confirm" name="new_password_confirm" minlength="8" data-max-bytes="72" autocomplete="new-password" placeholder="{{__ 'profile.password.confirm_placeholder'}}">
              <button type="button" class="btn btn-outline-secondary" data-toggle-password="new_password_confirm" aria-label="{{__ 'profile.password.show'}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
              </button>
            </div>
            <div class="invalid-feedback">{{__ 'error.password_max_bytes'}}</div>
            <div class="form-text">{{__ 'profile.password.max_bytes_help'}}</div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary w-100">{{__ 'profile.password.btn_change'}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="card-icon bg-success-subtle text-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0 1 2v7.938c0 2.19 1.158 3.903 3 4.727L8 16l4-1.335c1.842-.824 3-2.537 3-4.727V2L8 0Zm2.354 6.354a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708 0Z"/></svg>
          </span>
          <h5 class="mb-0">{{__ 'profile.twofactor.title'}}</h5>
        </div>
        {{#if totpEnabled}}
          <span class="badge bg-success fs-6">{{__ 'profile.twofactor.enabled'}}</span>
        {{else}}
          <span class="badge bg-secondary fs-6">{{__ 'profile.twofactor.disabled'}}</span>
        {{/if}}
      </div>
      <div class="card-body">
        {{#if totpEnabled}}
          <p class="text-muted small mb-3">
            {{__ 'profile.twofactor.disable_description'}}
          </p>
          <form method="POST" action="/profile/totp-disable" data-validate>
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <div class="mb-3">
              <label for="disable_password" class="form-label">{{__ 'profile.twofactor.current_password_label'}}</label>
              <input type="password" class="form-control" id="disable_password" name="current_password" required>
            </div>
            <button type="submit" class="btn btn-outline-danger w-100">{{__ 'profile.twofactor.btn_disable'}}</button>
          </form>
        {{else}}
          <p class="text-muted small mb-3">
            {{__ 'profile.twofactor.enable_description'}}
          </p>
          <form method="POST" action="/profile/totp-generate">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="btn btn-outline-primary w-100">{{__ 'profile.twofactor.btn_setup'}}</button>
          </form>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="card-icon bg-secondary-subtle text-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34ZM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858Z"/></svg>
          </span>
          <h5 class="mb-0">{{__ 'profile.admin.title'}}</h5>
        </div>
        {{#if debugMode}}
          <span class="badge bg-success fs-6">{{__ 'profile.admin.debug_on'}}</span>
        {{else}}
          <span class="badge bg-secondary fs-6">{{__ 'profile.admin.debug_off'}}</span>
        {{/if}}
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          {{__ 'profile.admin.debug_description'}}
        </p>
        <form method="POST" action="/profile/settings" id="debug-form">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="debug_mode" value="0" id="debug_mode_hidden">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="debug_mode" {{#if debugMode}}checked{{/if}}>
            <label class="form-check-label" for="debug_mode">{{__ 'profile.admin.debug_mode'}}</label>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="card-icon bg-info-subtle text-info-emphasis">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
          </span>
          <h5 class="mb-0">{{__ 'profile.admin.rotation_title'}}</h5>
        </div>
        {{#if rotationEnabled}}
          <span class="badge bg-success fs-6">{{__ 'profile.admin.rotation_on'}}</span>
        {{else}}
          <span class="badge bg-secondary fs-6">{{__ 'profile.admin.rotation_off'}}</span>
        {{/if}}
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          {{__ 'profile.admin.rotation_description'}}
        </p>
        <form method="POST" action="/profile/rotation" class="row g-2">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div class="col-md-6">
            <label class="form-label" for="log_rotate_size">{{__ 'profile.admin.rotate_size'}}</label>
            <input type="number" name="log_rotate_size" id="log_rotate_size" class="form-control form-control-sm" min="0" step="1" value="{{rotation.maxSizeKb}}">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="log_rotate_backups">{{__ 'profile.admin.rotate_backups'}}</label>
            <input type="number" name="log_rotate_backups" id="log_rotate_backups" class="form-control form-control-sm" min="0" step="1" value="{{rotation.backups}}">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-sm btn-primary">{{__ 'profile.admin.rotation_save'}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 text-center mt-2 mb-4">
    <a href="/" class="btn btn-outline-secondary">
      &larr; {{__ 'profile.back_to_dashboard'}}
    </a>
  </div>
</div>
